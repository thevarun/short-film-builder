# Copy to .env (gitignored; never committed). scripts/doctor.ts checks every line below.

# ElevenLabs — voices, forced alignment, music.  https://elevenlabs.io/app/settings/api-keys
# The key needs these permissions: Text to Speech, Speech to Text (forced alignment), Music.
ELEVENLABS_API_KEY=

# Google AI Studio — images (Nano Banana), used by the image MCP.  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud project with the Vertex AI API enabled — video (Veo 3.1).
# Optional: defaults to `gcloud config get-value project`.
# GOOGLE_CLOUD_PROJECT=
